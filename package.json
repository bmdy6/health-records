{
  "name": "health-records",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node scripts/local-server.mjs",
    "mcp": "node scripts/mcp-stdio.mjs",
    "mcp:http": "node scripts/food-remote/server.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs scripts/food-remote/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webdav": "^5.7.1",
    "zod": "4.6.7",
    "esbuild": "0.21.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.5.4",
    "vite": "^5.4.3",
    "vitest": "^4.1.10"
  },
  "description": "Self-hosted health records shared by the browser and MCP tools",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
